# Public frontend configuration (safe to commit — no secrets).
#
# Browser-facing API base URL. In development this is the same-origin proxy
# path (`/platform`) so the HTTPS dev origin (see the `dev` script) never
# issues mixed-content requests; next.config.ts forwards it to the backend.
NEXT_PUBLIC_API_BASE_URL=/platform
# Server-side base URL of the real backend, used by server components and as
# the `/platform` rewrite target. Not exposed to the browser.
PLATFORM_API_URL=http://localhost:3010
# The same public app id as the backend's PRIVY_APP_ID. It is a public
# identifier (safe in the browser); the matching secret stays server-side.
NEXT_PUBLIC_PRIVY_APP_ID=
