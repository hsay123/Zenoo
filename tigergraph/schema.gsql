# Zeno integrity graph (HHG F6.2) — TigerGraph schema.
#
# Only ids, wallet addresses and label-content hashes are stored: no buyer
# data, no emails, no media. Loaded by backend/lib/integrity/tigergraph.ts
# through REST++ upserts; queried by queries.gsql.
#
#   gsql schema.gsql      (then: gsql queries.gsql)

CREATE VERTEX Account (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Wallet (PRIMARY_ID address STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Job (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Asset (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Submission (PRIMARY_ID id STRING, content_hash STRING, has_content BOOL, status STRING) WITH primary_id_as_attribute="true"

CREATE UNDIRECTED EDGE USES_WALLET (FROM Account, TO Wallet, how STRING)
CREATE DIRECTED EDGE OWNS_JOB (FROM Account, TO Job)
CREATE DIRECTED EDGE SUBMITTED (FROM Account, TO Submission)
CREATE DIRECTED EDGE ON_ASSET (FROM Submission, TO Asset)
CREATE DIRECTED EDGE FOR_JOB (FROM Submission, TO Job)
CREATE DIRECTED EDGE REVIEWED (FROM Account, TO Submission)

CREATE GRAPH Zeno (Account, Wallet, Job, Asset, Submission, USES_WALLET, OWNS_JOB, SUBMITTED, ON_ASSET, FOR_JOB, REVIEWED)
