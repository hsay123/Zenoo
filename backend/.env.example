# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Private Storage bucket holding job media (default: media)
SUPABASE_STORAGE_BUCKET=media

# ── Frontend CORS ─────────────────────────────────────────────
# Browser origin of the app. Development serves over HTTPS on :3000 (see the
# root package.json `dev` script) so external-wallet (SIWE) login passes the
# wallet's origin check.
FRONTEND_ORIGIN=https://localhost:3000

# ── Privy (required in production) ────────────────────────────
# Found in: Privy dashboard > App Settings
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# ── DEV auth bypass ───────────────────────────────────────────
# Default OFF. Set to "true" ONLY for a local, non-evidence run; production
# refuses it at startup. When true, pass header: x-dev-user-id: <user-uuid>
DEV_AUTH_BYPASS=false

# ── Tuning ────────────────────────────────────────────────────
LEASE_MINUTES=30
AI_CONFIDENCE_THRESHOLD=0.75
GOLD_IOU_THRESHOLD=0.5
GOLD_SEGMENT_MS_TOLERANCE=500
# Submissions faster than this after claim are flagged for human review
FAST_SUBMIT_THRESHOLD_SECONDS=30

# ── Smart contracts (required for real settlement) ────────────
# Leave blank to use MockSettlementService
# ── Settlement ────────────────────────────────────────────────
# Real on-chain settlement is selected only when all three of these are set AND
# the fail-closed preflight passes at runtime:
#   JOB_ESCROW_ADDRESS + RPC_URL + SETTLEMENT_PRIVATE_KEY (+ USDC_ADDRESS,
#   CHAIN_ID on the allow-list, deny-list).
# Otherwise MockSettlementService is used and receipts stay is_mock=true.
#
# Chain: 84532 = Base Sepolia (the only chain allowed this week).
# 8453 = Base mainnet is refused by the preflight until the audit gate clears.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
# USDC (6 decimals) held by the escrow. Base Sepolia: Circle's test USDC.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# The USDC JobEscrow (ABI v3) deployed on CHAIN_ID.
JOB_ESCROW_ADDRESS=
# Deprecated alias for RPC_URL, read only when RPC_URL is unset. A Monad RPC
# fails the chain check, so settlement stays on the mock.
# MONAD_RPC_URL=
# Server-only relayer key. NEVER commit it or expose it to the browser.
SETTLEMENT_PRIVATE_KEY=
# REQUIRED before real settlement can be enabled: comma-separated addresses that
# must never sign or own the escrow (e.g. a key exposed in a screenshot). The
# preflight fails closed when this is empty and always also denies a built-in
# list of known-compromised addresses.
SETTLEMENT_FORBIDDEN_ADDRESS=

# ── Buyer funding (HHG F2) ────────────────────────────────────
# Zeno's fee as a share of what the buyer pays, in basis points (2000 = 20%;
# the contributor keeps 80%). Escrow holds only contributor payouts.
ZENO_FEE_BPS=2000
# Platform treasury signer that funds escrow after a verified card/UPI payment.
# A THIRD key: must differ from the escrow owner and the settlement relayer.
# Server-only; test USDC only. Blank = paid jobs wait as "paid, awaiting funding".
TREASURY_PRIVATE_KEY=
# Dodo Payments, TEST MODE ONLY (https://test.dodopayments.com). All three must
# be set for the card/UPI option to appear. DODO_PRODUCT_ID is a
# pay-what-you-want product; each checkout overrides its amount.
# Webhook endpoint: <backend>/api/payments/dodo/webhook (event: payment.succeeded)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=

# ── AI first pass (HHG F3) ────────────────────────────────────
# Real image review by Claude. Used only when ANTHROPIC_API_KEY is set and
# AI_REVIEWER is not "mock"; otherwise the mock reviewer stays (labelled mock-v1).
# Images are sent to Anthropic's API for review; video always goes to humans.
ANTHROPIC_API_KEY=
AI_REVIEWER=auto
AI_REVIEW_MODEL=claude-sonnet-5-5
AI_REVIEW_EFFORT=medium

# ── Contributor reputation (HHG F4) ───────────────────────────
# on: New = gold tasks only, Verified = paid images, Trusted = + video.
REPUTATION_GATING=on
REPUTATION_VERIFIED_MIN_GOLD=5
REPUTATION_VERIFIED_MIN_GOLD_ACCURACY=80
REPUTATION_TRUSTED_MIN_ACCEPTED=50
REPUTATION_TRUSTED_MIN_SCORE=85
REPUTATION_REVIEWER_MIN_ACCEPTED=200
REPUTATION_REVIEWER_MIN_SCORE=92

# ── Royalty split (HHG F5, ROADMAP DEMO) ──────────────────────
# Deployed RoyaltySplitter on CHAIN_ID. Blank = the admin demo previews only.
ROYALTY_SPLITTER_ADDRESS=

# ── Integrity checks (HHG F6.2) ───────────────────────────────
# TigerGraph Savanna workspace. Blank = in-process graph engine (same rules).
# Run tigergraph/schema.gsql then tigergraph/queries.gsql in the GSQL editor first.
# Host: the workspace domain, e.g. https://tg-<workspace-id>.tg-<n>.i.tgcloud.io
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=Zeno
# Preferred: a database secret (Savanna > Database Secrets), exchanged for a
# 1-hour token on each run. TIGERGRAPH_TOKEN (a fixed token) also works.
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=
